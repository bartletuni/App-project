generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  isAdmin         Boolean  @default(false)
  shippingAddress String?
  billingAddress  String?
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phoneNumbers PhoneNumber[]
  requests     PartRequest[]
}

model PhoneNumber {
  id        String   @id @default(cuid())
  number    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  requests PartRequest[]
}

model Material {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  imageId          String?
  createdAt        DateTime @default(now())
  tensileStrength  Float?
  stiffness        Float?
  hdt              Float?
  impactResistance Float?
}

/// A block of the public pricing sheet (e.g. "3D Printing", "Scanning").
model PricingSection {
  id        String   @id @default(cuid())
  title     String
  intro     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PricingItem[]
}

/// A single priced line inside a pricing section.
model PricingItem {
  id        String         @id @default(cuid())
  sectionId String
  section   PricingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label     String
  detail    String?
  price     String?
  note      String?
  sortOrder Int            @default(0)
}

/// Free-form copy on the pricing sheet (hero text, contact details, notes).
model PricingSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PartRequest {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  phoneNumberId  String
  phoneNumber    PhoneNumber @relation(fields: [phoneNumberId], references: [id])
  fileId         String // Cloudflare R2 file ID
  fileName       String // Original uploaded file name
  quantity       Int         @default(1)
  material       String?
  notes          String?
  printSettings  String? // JSON CustomPrintSettings; null = auto (shop chooses)
  quoteRequested Boolean     @default(false) // customer asked for a price quote first
  dateNeeded     DateTime
  status         String      @default("PENDING") // PENDING, CANCELLED, FULFILLED
  invoiceNumber  String?
  trackingNumber String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
