generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  isAdmin         Boolean  @default(false)
  shippingAddress String?
  billingAddress  String?
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phoneNumbers PhoneNumber[]
  requests     PartRequest[]
}

model PhoneNumber {
  id        String   @id @default(cuid())
  number    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  requests PartRequest[]
}

model Material {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  imageId          String?
  createdAt        DateTime @default(now())
  tensileStrength  Float?
  stiffness        Float?
  hdt              Float?
  impactResistance Float?
}

/// A block of the public pricing sheet (e.g. "3D Printing", "Scanning").
model PricingSection {
  id        String   @id @default(cuid())
  title     String
  intro     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PricingItem[]
}

/// A single priced line inside a pricing section.
model PricingItem {
  id        String         @id @default(cuid())
  sectionId String
  section   PricingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label     String
  detail    String?
  price     String?
  note      String?
  sortOrder Int            @default(0)
}

/// Free-form copy on the pricing sheet (hero text, contact details, notes).
model PricingSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PartRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  phoneNumberId   String
  phoneNumber     PhoneNumber @relation(fields: [phoneNumberId], references: [id])
  /// How the part arrived: MODEL (an .stl/.zip was uploaded) or DESCRIPTION
  /// (no model yet — the customer described the part for us to draw).
  submissionType  String      @default("MODEL")
  fileId          String? // Cloudflare R2 file ID; null on DESCRIPTION requests
  fileName        String? // Original uploaded file name; null on DESCRIPTION requests
  /// What the customer calls the part. Stands in for fileName on DESCRIPTION
  /// requests, which have no file to name them.
  partName        String?
  /// The customer's account of the part on a DESCRIPTION request.
  partDescription String?
  /// Free-form size notes on a DESCRIPTION request, e.g. "80 x 40 x 12 mm".
  dimensions      String?
  quantity        Int         @default(1)
  material        String?
  notes           String?
  printSettings   String? // JSON CustomPrintSettings; null = auto (shop chooses)
  quoteRequested  Boolean     @default(false) // customer asked for a price quote first
  /// Which track this row is on, and therefore which set of statuses it uses:
  /// QUOTE (being priced, nothing built yet) or REQUEST (a live build). An
  /// admin moves a quote across with POST /api/requests/[id]/convert.
  /// See src/lib/request-status.ts.
  kind            String      @default("REQUEST")
  /// What the shop quoted, free-form so it can carry a currency or a range
  /// ("$142.50", "$120–$160 pending material"). Survives conversion.
  quotedPrice     String?
  /// When a quote became a build request; null on anything never quoted.
  convertedAt     DateTime?
  dateNeeded      DateTime
  /// A value from QUOTE_STATUSES or REQUEST_STATUSES depending on `kind`.
  status          String      @default("PENDING")
  invoiceNumber   String?
  trackingNumber  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  attachments RequestAttachment[]
}

/// A reference photo, sketch, or drawing attached to a request. These are how a
/// customer without a 3D model shows us the part.
model RequestAttachment {
  id        String      @id @default(cuid())
  requestId String
  request   PartRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileId    String      @unique // Cloudflare R2 object key
  fileName  String
  mimeType  String
  size      Int
  createdAt DateTime    @default(now())
}
