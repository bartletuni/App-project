generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  isAdmin         Boolean  @default(false)
  /// Marks the single system row that owns every no-account quote — not a
  /// customer, and never one. A quote sent from the public form is deliberately
  /// NOT attached to whatever account happens to share its email address: a
  /// stranger who knows someone's address must not be able to put anything on
  /// their desk. The contact details a guest gives ride on the request instead
  /// (PartRequest.guestEmail and friends), and the shop answers those.
  ///
  /// Its password is random and held by nobody, its address is on a reserved
  /// domain that cannot receive mail, and the Clients list filters it out.
  /// Owning guest quotes here rather than leaving them unowned is what keeps
  /// their uploaded files behind the admin check in /api/download/[fileId],
  /// which treats an unowned file as public.
  isGuest         Boolean  @default(false)
  shippingAddress String?
  billingAddress  String?
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phoneNumbers PhoneNumber[]
  requests     PartRequest[]
}

model PhoneNumber {
  id        String   @id @default(cuid())
  number    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  requests PartRequest[]
}

model Material {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  imageId          String?
  createdAt        DateTime @default(now())
  tensileStrength  Float?
  stiffness        Float?
  hdt              Float?
  impactResistance Float?
}

/// A block of the public pricing sheet (e.g. "3D Printing", "Scanning").
model PricingSection {
  id        String   @id @default(cuid())
  title     String
  intro     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PricingItem[]
}

/// A single priced line inside a pricing section.
model PricingItem {
  id        String         @id @default(cuid())
  sectionId String
  section   PricingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label     String
  detail    String?
  price     String?
  note      String?
  sortOrder Int            @default(0)
}

/// Free-form copy on the pricing sheet (hero text, contact details, notes).
model PricingSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PartRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  phoneNumberId   String
  phoneNumber     PhoneNumber @relation(fields: [phoneNumberId], references: [id])
  /// How the part arrived: MODEL (an .stl/.zip was uploaded) or DESCRIPTION
  /// (no model yet — the customer described the part for us to draw).
  submissionType  String      @default("MODEL")
  fileId          String? // Cloudflare R2 file ID; null on DESCRIPTION requests
  fileName        String? // Original uploaded file name; null on DESCRIPTION requests
  /// What the customer calls the part. Stands in for fileName on DESCRIPTION
  /// requests, which have no file to name them.
  partName        String?
  /// The customer's account of the part on a DESCRIPTION request.
  partDescription String?
  /// Free-form size notes on a DESCRIPTION request, e.g. "80 x 40 x 12 mm".
  dimensions      String?
  quantity        Int         @default(1)
  material        String?
  notes           String?
  printSettings   String? // JSON CustomPrintSettings; null = auto (shop chooses)
  quoteRequested  Boolean     @default(false) // customer asked for a price quote first
  /// Who to answer, on a quote that came in through the public form at /quote.
  /// Set together and only there — `guestEmail` is what marks a row as a
  /// no-account quote, and its presence is why the console shows these instead
  /// of the system row that owns it. Null on everything submitted by a
  /// signed-in customer, whose details are on their account.
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  /// True on the one free PLA 2.0 sample a first-time customer may request.
  /// Eligibility is meant to be "no existing row with this flag set for the
  /// user", not "no requests at all" — so someone who ordered before the
  /// sample program existed can still claim one.
  isFreeSample    Boolean     @default(false)
  /// Which track this row is on, and therefore which set of statuses it uses:
  /// QUOTE (being priced, nothing built yet) or REQUEST (a live build). An
  /// admin moves a quote across with POST /api/requests/[id]/convert.
  /// See src/lib/request-status.ts.
  kind            String      @default("REQUEST")
  /// What the shop quoted, free-form so it can carry a currency or a range
  /// ("$142.50", "$120–$160 pending material"). Survives conversion.
  quotedPrice     String?
  /// When a quote became a build request; null on anything never quoted.
  convertedAt     DateTime?
  dateNeeded      DateTime
  /// A value from QUOTE_STATUSES or REQUEST_STATUSES depending on `kind`.
  status          String      @default("PENDING")
  invoiceNumber   String?
  trackingNumber  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  attachments RequestAttachment[]
}

/// A reference photo, sketch, or drawing attached to a request. These are how a
/// customer without a 3D model shows us the part.
model RequestAttachment {
  id        String      @id @default(cuid())
  requestId String
  request   PartRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileId    String      @unique // Cloudflare R2 object key
  fileName  String
  mimeType  String
  size      Int
  createdAt DateTime    @default(now())
}

/// One fixed window of activity on a public, unauthenticated endpoint.
///
/// The no-account quote form is the first thing on this site that anyone can
/// POST to, so it needs a ceiling that survives a serverless cold start — an
/// in-process counter resets with every new lambda and protects nothing. The
/// window is encoded in the key ("guest-quote:ip:<hash>:<window index>"), so a
/// new window is simply a new row and a counter is one upsert. Keys are opaque:
/// an address is stored as an HMAC, never in the clear. See src/lib/rate-limit.ts.
model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
}
