generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  isAdmin         Boolean  @default(false)
  shippingAddress String?
  billingAddress  String?
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phoneNumbers PhoneNumber[]
  requests     PartRequest[]

  // Performance Optimization (Bolt): Adding an index on `createdAt` significantly speeds up sorting operations,
  // as users and reports are frequently requested in descending order of creation. This prevents full table scans.
  @@index([createdAt])
}

model PhoneNumber {
  id        String   @id @default(cuid())
  number    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  requests  PartRequest[]

  // Performance Optimization (Bolt): SQLite does not index foreign keys by default.
  // Adding an index on `userId` improves the performance of relational queries linking numbers to users.
  @@index([userId])
  // Performance Optimization (Bolt): Adding an index to `createdAt` speeds up order-by queries.
  @@index([createdAt])
}

model Material {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageId     String?
  createdAt   DateTime @default(now())
}

model PartRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  phoneNumberId String
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id])
  fileId        String      // Google Drive file ID
  fileName      String      // Original uploaded file name
  quantity      Int         @default(1)
  material      String?
  notes         String?
  dateNeeded    DateTime
  status        String      @default("PENDING") // PENDING, CANCELLED, FULFILLED
  invoiceNumber String?
  trackingNumber String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Performance Optimization (Bolt): SQLite does not automatically index foreign keys.
  // Indexing `userId` and `phoneNumberId` drastically improves relational query performance and filtering.
  @@index([userId])
  @@index([phoneNumberId])
  // Performance Optimization (Bolt): Indexing `createdAt` improves sorting performance for lists and admin reports.
  @@index([createdAt])
}
